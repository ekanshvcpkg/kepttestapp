# PostgreSQL (Neon free tier works for both local dev and the cloud deploy).
# Render/Railway free disks are ephemeral, so a SQLite file would be wiped on every deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

DEVNET_RPC_URL="https://api.devnet.solana.com"

# PUBLIC key only. The backend never needs (and must never be given) a private key.
TREASURY_ADDRESS="4AxmDUCWpC8F1aGL6ZsgyJoHfM3FDcK3AMbgMmcjD6jR"

# The deployed kept_test Anchor program (Keeper XP / Soul / Aura trigger). Public ID, safe to commit.
KEEPER_PROGRAM_ID="6iXXBqsdiCnUTSVf8CW3Uuw8c7iYvZSj5haz64QMuMUh"

# --- Aura (compressed NFT) minting. Leave unset to disable. ---
# Created by `npm run aura:setup` (prints the tree address).
AURA_MERKLE_TREE=""
# SECRET, Devnet only. The JSON array in .aura-minter.json; set it on the host, never commit.
AURA_MINTER_SECRET_KEY=""
# Shared secret; set the same value as the Helius webhook's Authorization header.
WEBHOOK_SECRET=""
# Public URL of this backend (Render sets RENDER_EXTERNAL_URL for you).
PUBLIC_BASE_URL=""

# Set automatically by Render/Railway. Only set it yourself for local runs.
PORT=3000
