# Backend runtime (copy to .env; never commit secrets)
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kept?schema=public
DEVNET_RPC_URL=https://api.devnet.solana.com
KEEPER_PROGRAM_ID=6iXXBqsdiCnUTSVf8CW3Uuw8c7iYvZSj5haz64QMuMUh
SESSION_SECRET=replace-with-at-least-32-random-bytes
VERIFIER_SECRET_KEY=[64-byte Solana keypair JSON]
FAUCET_SECRET_KEY=[64-byte Solana keypair JSON]
STAKE_MINT=
# SPL token account for the treasury; `npm run v4:setup` prints this ATA.
TREASURY_TOKEN_ACCOUNT=
# Wallet that owns the treasury ATA. Used by v4:setup, not read by the backend.
TREASURY_OWNER=52eWttmzYBJn4awLjEMB42bw5oTFvL4XC1gDqFAQgPxJ
# For local prototype testing only; restrict to tester wallets.
SGT_MOCK=true
SGT_MOCK_ALLOWLIST=WalletPublicKey1,WalletPublicKey2
# Token-2022 group address for real Genesis-token membership validation.
GENESIS_GROUP=
# Use persistent private storage; oath photos are removed after settlement.
PROOF_STORAGE_DIR=/var/lib/kept/proofs
# JSON service account object for Firebase Cloud Messaging HTTP v1.
FCM_SERVICE_ACCOUNT_JSON=
